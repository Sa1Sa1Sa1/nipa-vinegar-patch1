<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nipa Vinegar Mosquito Patch</title>

<!-- Firebase CDN (COMPAT – OK for your code) -->
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

<style>
body {
  margin: 0;
  font-family: "Segoe UI", sans-serif;
  background: #eef7ef;
  color: #1b3c1b;
}

header {
  background: linear-gradient(to right, #2e7d32, #66bb6a);
  padding: 20px;
  text-align: center;
  font-size: 28px;
  color: white;
  font-weight: bold;
}

nav {
  display: flex;
  justify-content: center;
  gap: 12px;
  padding: 12px;
  background: #1b5e20;
}

nav a {
  color: white;
  background: #2e7d32;
  padding: 10px 18px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}

nav a.active, nav a:hover {
  background: #a5d6a7;
  color: #1b3c1b;
}

.section {
  display: none;
  padding: 25px;
}

.active-section {
  display: block;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 14px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  margin-top: 15px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #1b5e20;
}

input, textarea {
  width: 100%;
  padding: 8px;
  border-radius: 8px;
  border: 1px solid #ccc;
}

button {
  background: #1b5e20;
  color: white;
  padding: 10px 20px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

#stars span {
  font-size: 28px;
  cursor: pointer;
  color: #ccc;
}

#stars span.active {
  color: #ffb300;
}
</style>
</head>

<body>

<header>🌿 Nipa Vinegar Mosquito Patch</header>

<nav>
  <a href="#home" class="active">Home</a>
  <a href="#reviews">Reviews</a>
  <a href="#feedback">Feedback</a>
</nav>

<section id="home" class="section active-section">
  <div class="title">Welcome!</div>
  <div class="card">
    A natural, eco-friendly mosquito repellent made from nipa vinegar 🌿
  </div>
</section>

<section id="reviews" class="section">
  <div class="title">User Reviews</div>
</section>

<section id="feedback" class="section">
  <div class="title">Send Your Feedback</div>
  <div class="card">
    <input id="fbName" placeholder="Your Name"><br><br>
    <textarea id="fbText" rows="4" placeholder="Your Feedback"></textarea><br><br>

    <label>Rate the Product:</label><br>
    <div id="stars">
      <span onclick="setRating(1)">★</span>
      <span onclick="setRating(2)">★</span>
      <span onclick="setRating(3)">★</span>
      <span onclick="setRating(4)">★</span>
      <span onclick="setRating(5)">★</span>
    </div>

    <input type="hidden" id="rating" value="0"><br>
    <button onclick="submitFeedback()">Submit Feedback</button>
  </div>
</section>

<script>
/* 🔥 FIREBASE CONFIG (FIXED) */
const firebaseConfig = {
  apiKey: "AIzaSyAYXtsa6-39JuvzgAueoeoNyAi2UBSvyt0",
  authDomain: "nipavinegarpatch.firebaseapp.com",
  projectId: "nipavinegarpatch",
  storageBucket: "nipavinegarpatch.appspot.com",
  messagingSenderId: "831718429416",
  appId: "1:831718429416:web:a62b799a85722c2bf2af5d"
};

firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();

/* 🔀 NAVIGATION */
const sections = document.querySelectorAll(".section");
const links = document.querySelectorAll("nav a");

links.forEach(link => {
  link.onclick = e => {
    e.preventDefault();
    sections.forEach(s => s.classList.remove("active-section"));
    links.forEach(l => l.classList.remove("active"));

    document.getElementById(link.getAttribute("href").substring(1))
      .classList.add("active-section");
    link.classList.add("active");
  };
});

/* ⭐ STAR RATING */
function setRating(val) {
  rating.value = val;
  document.querySelectorAll("#stars span")
    .forEach((s, i) => s.classList.toggle("active", i < val));
}

/* ✍️ SUBMIT REVIEW */
function submitFeedback() {
  const name = fbName.value || "Anonymous";
  const text = fbText.value.trim();
  const rate = Number(rating.value);

  if (!text || rate === 0) {
    alert("Please add feedback and rating.");
    return;
  }

  db.collection("reviews").add({
    name,
    text,
    rating: rate,
    timestamp: firebase.firestore.FieldValue.serverTimestamp()
  })
  .then(() => {
    alert("Feedback submitted!");
    fbName.value = "";
    fbText.value = "";
    rating.value = 0;
    document.querySelectorAll("#stars span").forEach(s => s.classList.remove("active"));
  })
  .catch(err => {
    console.error(err);
    alert("Firestore error. Check rules.");
  });
}

/* 📥 LOAD REVIEWS (THIS MAKES THEM STAY) */
function addReview(review) {
  const div = document.createElement("div");
  div.className = "card";
  div.innerHTML = `
    <b>${review.name}</b><br>
    ${"★".repeat(review.rating)}<br>
    ${review.text}
  `;
  document.getElementById("reviews").appendChild(div);
}

db.collection("reviews")
  .orderBy("timestamp", "desc")
  .onSnapshot(snapshot => {
    document.getElementById("reviews").innerHTML =
      "<div class='title'>User Reviews</div>";
    snapshot.forEach(doc => addReview(doc.data()));
  });
</script>

</body>
</html>
